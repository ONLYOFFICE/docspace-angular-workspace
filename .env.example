# Copy to .env and fill in — Storybook reads these; the published library does not.
# Only STORYBOOK_-prefixed variables reach the browser bundle.

# The ONLYOFFICE Apps workspace every story points at.
STORYBOOK_DOCSPACE_URL=https://your-instance.onlyoffice.com

# The file the Editor story opens. Any file id from the workspace above.
STORYBOOK_DOCSPACE_FILE_ID=

{
  "name": "@onlyoffice/docspace-angular-workspace",
  "description": "Angular workspace for the @onlyoffice/docspace-angular library, an Angular component for embedding ONLYOFFICE DocSpace.",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ONLYOFFICE/docspace-angular-workspace/issues",
    "email": "support@onlyoffice.com"
  },
  "homepage": "https://www.onlyoffice.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONLYOFFICE/docspace-angular-workspace.git"
  },
  "author": "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)",
  "maintainers": [
    "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)"
  ],
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "storybook": "ng run @onlyoffice/docspace-angular:storybook",
    "build-storybook": "ng run @onlyoffice/docspace-angular:build-storybook"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.35",
    "@angular/animations": "^20.3.30",
    "@angular/build": "^20.3.35",
    "@angular/cli": "^20.3.35",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.30",
    "@onlyoffice/docspace-sdk-js": "^2.2.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/angular": "^10.5.10",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "storybook": "^10.5.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "webpack-dev-middleware": "^7.4.5"
  }
}
